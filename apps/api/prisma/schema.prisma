generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ConversationType {
  DIRECT
  GROUP
  DEPARTMENT
  PROJECT
  ANNOUNCEMENT
}

enum ConversationMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
  FILE
}

enum TaskStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  BLOCKED
  WAITING_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApprovalTypeStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ApprovalApproverRule {
  USER
  REQUESTER_MANAGER
  DEPARTMENT_MANAGER
  ROLE
}

enum ApprovalRequestStatus {
  DRAFT
  SUBMITTED
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum NotificationType {
  MESSAGE
  MENTION
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_UPDATED
  TASK_DUE
  TASK_OVERDUE
  APPROVAL_PENDING
  APPROVAL_UPDATED
  SYSTEM
}

model Department {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String         @unique
  code               String         @unique
  managerId          String?        @db.Uuid
  manager            User?          @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  driveGrants        DriveGrant[]
  users              User[]         @relation("UserDepartment")
  conversations      Conversation[]
  tasks              Task[]
  approvalRequests   ApprovalRequest[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([managerId])
}

model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  employeeNumber            String?                   @unique
  email                     String                    @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  displayName               String
  phone                     String?
  jobTitle                  String?
  status                    UserStatus                @default(ACTIVE)
  departmentId              String?                   @db.Uuid
  department                Department?               @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  managerId                 String?                   @db.Uuid
  manager                   User?                     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports             User[]                    @relation("UserManager")
  managedDepartments        Department[]              @relation("DepartmentManager")
  preferredLanguage         String                    @default("en")
  timezone                  String                    @default("Asia/Tbilisi")
  lastSeenAt                DateTime?
  roles                     UserRole[]
  sessions                  Session[]
  memberships               ConversationMember[]
  ownedConversations        Conversation[]            @relation("ConversationOwner")
  messages                  Message[]
  messageReceipts           MessageReceipt[]
  createdTasks              Task[]                    @relation("TaskCreator")
  taskGroups                 TaskGroup[]               @relation("TaskGroupOwner")
  taskLayouts                UserTaskLayout[]
  assignedTasks             Task[]                    @relation("TaskAssignee")
  taskParticipants          TaskParticipant[]
  taskComments              TaskComment[]
  taskHistory               TaskHistory[]
  createdApprovalTypes      ApprovalType[]
  requestedApprovals        ApprovalRequest[]         @relation("ApprovalRequester")
  approvalSteps             ApprovalRequestStep[]     @relation("ApprovalStepApprover")
  approvalComments          ApprovalComment[]
  driveItems                DriveItem[]
  driveGrants               DriveGrant[]
  uploadedFiles             FileObject[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([departmentId, status])
  @@index([managerId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, expiresAt])
}

model Conversation {
  id          String               @id @default(uuid()) @db.Uuid
  type        ConversationType
  name        String?
  description String?
  directKey   String?              @unique
  departmentId String?             @db.Uuid
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownerId     String?              @db.Uuid
  owner       User?                @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isArchived  Boolean              @default(false)
  members     ConversationMember[]
  messages    Message[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([departmentId])
  @@index([updatedAt])
}

model ConversationMember {
  conversationId   String                 @db.Uuid
  userId           String                 @db.Uuid
  role             ConversationMemberRole @default(MEMBER)
  joinedAt         DateTime               @default(now())
  leftAt           DateTime?
  mutedUntil       DateTime?
  lastReadMessageId String?               @db.Uuid
  conversation     Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  id               String              @id @default(uuid()) @db.Uuid
  conversationId   String              @db.Uuid
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String              @db.Uuid
  sender           User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyToMessageId String?             @db.Uuid
  replyToMessage   Message?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]           @relation("MessageReplies")
  type             MessageType         @default(TEXT)
  content          String
  editedAt         DateTime?
  deletedAt        DateTime?
  attachments      MessageAttachment[]
  receipts         MessageReceipt[]
  createdAt        DateTime            @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
}

model MessageReceipt {
  messageId   String   @db.Uuid
  userId      String   @db.Uuid
  deliveredAt DateTime?
  readAt      DateTime?
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, readAt])
  @@index([messageId, deliveredAt, readAt])
}

model Task {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  creatorId      String            @db.Uuid
  creator        User              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeId     String?           @db.Uuid
  assignee       User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  departmentId   String?           @db.Uuid
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentTaskId   String?           @db.Uuid
  parentTask     Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks       Task[]            @relation("TaskHierarchy")
  subtaskPosition Int             @default(0)
  status         TaskStatus        @default(OPEN)
  priority       TaskPriority      @default(NORMAL)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  archivedAt     DateTime?
  participants   TaskParticipant[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  history        TaskHistory[]
  layouts        UserTaskLayout[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([assigneeId, status, dueDate])
  @@index([departmentId, status])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([parentTaskId, subtaskPosition])
}

model TaskGroup {
  id         String           @id @default(uuid()) @db.Uuid
  name       String
  ownerId    String           @db.Uuid
  owner      User             @relation("TaskGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  position   Int              @default(0)
  archivedAt DateTime?
  layouts    UserTaskLayout[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([ownerId, archivedAt, position])
}

model UserTaskLayout {
  userId    String     @db.Uuid
  taskId    String     @db.Uuid
  groupId   String?    @db.Uuid
  position  Int        @default(0)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group     TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([userId, taskId])
  @@index([userId, groupId, position])
  @@index([groupId])
}

model TaskParticipant {
  taskId String @db.Uuid
  userId String @db.Uuid
  role   String @default("PARTICIPANT")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskComment {
  id          String                  @id @default(uuid()) @db.Uuid
  taskId      String                  @db.Uuid
  task        Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String                  @db.Uuid
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content     String
  editedAt    DateTime?
  deletedAt   DateTime?
  attachments TaskCommentAttachment[]
  createdAt   DateTime                @default(now())

  @@index([taskId, createdAt])
}

model TaskHistory {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @db.Uuid
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actionType String
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
}

model ApprovalType {
  id          String                    @id @default(uuid()) @db.Uuid
  code        String                    @unique
  name        String
  description String?
  version     Int                       @default(1)
  status      ApprovalTypeStatus        @default(DRAFT)
  formSchema  Json
  createdById String                    @db.Uuid
  createdBy   User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  steps       ApprovalTypeStep[]
  requests    ApprovalRequest[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model ApprovalTypeStep {
  id             String                @id @default(uuid()) @db.Uuid
  approvalTypeId String                @db.Uuid
  approvalType   ApprovalType          @relation(fields: [approvalTypeId], references: [id], onDelete: Cascade)
  stepNumber     Int
  name           String
  approverRule   ApprovalApproverRule
  approverValue  String?
  isRequired     Boolean               @default(true)

  @@unique([approvalTypeId, stepNumber])
}

model ApprovalRequest {
  id                  String                   @id @default(uuid()) @db.Uuid
  approvalTypeId      String                   @db.Uuid
  approvalType        ApprovalType             @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  approvalTypeVersion Int
  requesterId         String                   @db.Uuid
  requester           User                     @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  departmentId        String?                  @db.Uuid
  department          Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title               String
  data                Json
  workflowSnapshot    Json?
  status              ApprovalRequestStatus    @default(DRAFT)
  rounds              Json                     @default("[]")
  revision            Int                      @default(0)
  currentStepNumber   Int?
  submittedAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  steps               ApprovalRequestStep[]
  comments            ApprovalComment[]
  attachments         ApprovalAttachment[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ApprovalRequestStep {
  id                String              @id @default(uuid()) @db.Uuid
  approvalRequestId String              @db.Uuid
  approvalRequest   ApprovalRequest     @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepNumber        Int
  stepName          String
  approverId        String              @db.Uuid
  approver          User                @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: Restrict)
  status            ApprovalStepStatus  @default(WAITING)
  actedAt           DateTime?
  comment           String?

  @@unique([approvalRequestId, stepNumber])
  @@index([approverId, status])
}

model ApprovalComment {
  id                String          @id @default(uuid()) @db.Uuid
  approvalRequestId String          @db.Uuid
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  authorId          String          @db.Uuid
  author            User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content           String
  createdAt         DateTime        @default(now())
}

model FileObject {
  id                  String                  @id @default(uuid()) @db.Uuid
  originalName        String
  objectKey           String                  @unique
  bucket              String
  mimeType            String
  sizeBytes           Int
  checksum            String?
  uploadedById        String                  @db.Uuid
  uploadedBy          User                    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  scanStatus          FileScanStatus          @default(PENDING)
  deletedAt           DateTime?
  driveItem           DriveItem?
  messageAttachments  MessageAttachment[]
  taskAttachments     TaskAttachment[]
  taskCommentAttachments TaskCommentAttachment[]
  approvalAttachments ApprovalAttachment[]
  createdAt           DateTime                @default(now())

  @@index([uploadedById, createdAt(sort: Desc)])
}

model MessageAttachment {
  messageId String     @db.Uuid
  fileId    String     @db.Uuid
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([messageId, fileId])
}

model TaskAttachment {
  taskId String     @db.Uuid
  fileId String     @db.Uuid
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file   FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([taskId, fileId])
}

model TaskCommentAttachment {
  taskCommentId String      @db.Uuid
  fileId        String      @db.Uuid
  taskComment   TaskComment @relation(fields: [taskCommentId], references: [id], onDelete: Cascade)
  file          FileObject  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([taskCommentId, fileId])
}

model ApprovalAttachment {
  approvalRequestId String          @db.Uuid
  fileId            String          @db.Uuid
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  file              FileObject      @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([approvalRequestId, fileId])
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              NotificationType
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  deduplicationKey  String?          @unique
  createdAt         DateTime         @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actionType String
  entityType String
  entityId   String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  beforeData Json?
  afterData  Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}


enum DriveKind {
  FOLDER
  FILE
}

enum DriveAccess {
  VIEWER
  EDITOR
}

model DriveItem {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  kind      DriveKind
  ownerId   String @db.Uuid
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  parentId  String? @db.Uuid
  parent    DriveItem? @relation("DriveTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  DriveItem[] @relation("DriveTree")
  fileId    String? @unique @db.Uuid
  file      FileObject? @relation(fields: [fileId], references: [id], onDelete: Restrict)
  grants    DriveGrant[]
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, deletedAt])
  @@index([ownerId, deletedAt])
}

model DriveGrant {
  id           String @id @default(uuid()) @db.Uuid
  itemId       String @db.Uuid
  item         DriveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String? @db.Uuid
  user         User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String? @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  access       DriveAccess
  createdAt    DateTime @default(now())

  @@unique([itemId, userId])
  @@unique([itemId, departmentId])
}
