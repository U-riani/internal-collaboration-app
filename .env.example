# Run: node scripts/setup.mjs  (or add --demo for local demo accounts)
POSTGRES_DB=collaboration
POSTGRES_USER=collaboration
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://collaboration:replace_with_random_database_password@postgres:5432/collaboration?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Optional existing S3/MinIO backend. See docs/DEPLOYMENT.md before switching.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=collaboration_minio
MINIO_ROOT_PASSWORD=replace_with_random_storage_password
MINIO_BUCKET_ATTACHMENTS=attachments

APP_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_PORT=3000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Files stay private in a persistent Docker volume by default.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/files
MAX_UPLOAD_SIZE_MB=100
STORAGE_QUOTA_MB=2048


# Seed accounts. Change or remove before production.
SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_random_admin_password
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=replace_with_random_manager_password
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=replace_with_random_employee_password
