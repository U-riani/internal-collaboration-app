# Production database. Keep the password URL-safe because it is inserted into DATABASE_URL.
POSTGRES_DB=collaboration
POSTGRES_USER=collaboration
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password

# Public application origin. Replace this before enabling Cloudflare Tunnel.
APP_ORIGIN=https://collab.example.com
API_PORT=3000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
NODE_ENV=production

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Files are private and served only through authenticated API routes.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/files
# Streaming uploads can be large without buffering the whole file in Node memory.
# Current schema supports at most 2047 MB per stored file.
MAX_UPLOAD_SIZE_MB=2047
# Spreadsheet snapshots are JSON and are buffered/parsed in memory, so keep a
# separate ceiling. Raise to at most 512 only after checking server RAM.
MAX_SHEET_SNAPSHOT_MB=256
STORAGE_QUOTA_MB=10240

# One-time initial production administrator. Do not use demo passwords.
SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Required by current environment validation even though local storage is selected.
MINIO_ENDPOINT=minio-disabled
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=unused
MINIO_ROOT_PASSWORD=not-used-local-storage
MINIO_BUCKET_ATTACHMENTS=attachments

# Local-only Nginx test port on the server.
WEB_PORT=8080

# Create a remotely managed Cloudflare Tunnel, then place its token here.
# The cloudflared service is disabled until the "tunnel" Compose profile is enabled.
CLOUDFLARE_TUNNEL_TOKEN=
