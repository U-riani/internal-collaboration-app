# Copy as .env.staging; replace all sample credentials before use.
POSTGRES_DB=collab_staging
POSTGRES_USER=collab_staging
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_STAGING_DATABASE_PASSWORD
STAGING_WEB_PORT=18080
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_STAGING_ONLY_SECRET_32_CHARS_MIN
APP_ORIGIN=http://localhost:18080
API_PORT=3000
LOG_LEVEL=info
COOKIE_SECURE=false
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/files
STORAGE_QUOTA_MB=1024
MAX_UPLOAD_SIZE_MB=2047
MAX_SHEET_SNAPSHOT_MB=256
MINIO_ROOT_USER=staging
MINIO_ROOT_PASSWORD=REPLACE_WITH_STAGING_ONLY_UNUSED_STORAGE_PASSWORD
# Never copy Production push/FCM secrets into staging.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
SEED_DEMO=false
SEED_ADMIN_EMAIL=stage-admin@example.invalid
SEED_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STAGING_ADMIN_PASSWORD
