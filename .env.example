# PostgreSQL is required for local development and production.
# Create the database/user first, then replace the credentials below.
DATABASE_URL=postgresql://collaboration:change_me@127.0.0.1:5432/collaboration?schema=public

APP_ORIGIN=http://localhost:5173
API_PORT=3000
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Local development keeps uploaded files on disk while PostgreSQL stores metadata.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.local/files
MAX_UPLOAD_SIZE_MB=100
STORAGE_QUOTA_MB=2048

# Local demo data.
DEV_AUTO_SEED=true
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=Manager123!
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee123!

# Optional S3-compatible storage.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=local
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET_ATTACHMENTS=attachments
