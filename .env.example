# Local development does not require Docker, PostgreSQL, Redis, or MinIO.
# `npm run dev` starts an embedded persistent PostgreSQL-compatible database
# and stores uploaded files under apps/api/.local/.

APP_ORIGIN=http://localhost:5173
API_PORT=3000
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./apps/api/.local/files
MAX_UPLOAD_SIZE_MB=100
STORAGE_QUOTA_MB=2048

# Local demo data (used by `npm run dev`).
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=Manager123!
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee123!

# Only required when running `npm --prefix apps/api start` against an external DB.
DATABASE_URL=postgresql://collaboration:change_me@127.0.0.1:5432/collaboration?schema=public

# Optional S3-compatible storage. Local development uses STORAGE_DRIVER=local.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=local
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET_ATTACHMENTS=attachments
